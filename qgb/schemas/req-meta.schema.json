{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yumeno/Quality-gate-builder/schemas/req-meta.schema.json",
  "title": "qgb REQ metadata",
  "type": "object",
  "required": ["req_id", "stages"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Optional in Phase 1; will become required once REQ meta migrations begin."
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "initial_phase": {
      "type": "string",
      "enum": ["red", "green", "refactor", "verify"],
      "description": "Optional initial TDD phase, set by qgb tdd-init."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "contract_ref"],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1,
            "description": "Must match an id defined in policy.json#/stages."
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative path to the contract.json for this stage."
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "waived": {
            "type": "boolean",
            "default": false
          },
          "waiver_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "waived": { "const": true } },
              "required": ["waived"]
            },
            "then": {
              "required": ["waiver_reason"]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
