{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yumeno/Quality-gate-builder/schemas/gate.schema.json",
  "title": "qgb gate report (curated, strict)",
  "description": "Schema for the curated gate.json under evidence/<REQ>/latest/. Strict (additionalProperties false) at every level to keep committed evidence clean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "req_id",
    "timestamp_utc",
    "timestamp_rfc3339",
    "run_id",
    "phase",
    "status",
    "failed_stage",
    "decision",
    "runner",
    "paths",
    "stages",
    "basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
    },
    "timestamp_utc": {
      "type": "string",
      "description": "Compact UTC timestamp (wall-clock truth, seconds precision): YYYY-MM-DDTHHMMSSZ. Same instant as timestamp_rfc3339. The trailing path segment of paths.run_dir is <timestamp_utc>-<run_id>, not timestamp alone, so two runs inside the same wall-clock second remain distinguishable without falsifying the timestamp.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(0[0-9]|1[0-9]|2[0-3])([0-5][0-9]){2}Z$"
    },
    "timestamp_rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "description": "Per-second monotonic counter that disambiguates run directories when timestamp_utc collides. Format: 'r' followed by 4 lowercase hex digits ('r0001' to 'rffff'), assigned at run_dir reservation time and embedded in paths.run_dir. Has no relationship to timestamp meaning; timestamp_utc stays honest. r0000 is reserved (the runner starts counting from r0001) so an externally produced gate.json cannot claim a run_id the implementation can never generate.",
      "pattern": "^r[0-9a-f]{4}$",
      "not": { "const": "r0000" }
    },
    "phase": {
      "type": "string",
      "enum": ["red", "green", "refactor", "verify"]
    },
    "status": {
      "type": "string",
      "enum": ["ALLOW", "DENY"]
    },
    "failed_stage": {
      "type": "string",
      "description": "Empty string when status=ALLOW; first failed stage id when status=DENY."
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "meaning"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["ALLOW", "DENY"]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_dir", "curated_latest_dir"],
      "properties": {
        "run_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Volatile run directory. Trailing segment shape: <timestamp_utc>-<run_id> where timestamp_utc matches the field of the same name (YYYY-MM-DDTHHMMSSZ) and run_id matches r[0-9a-f]{4} excluding r0000.",
          "pattern": "/[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(0[0-9]|1[0-9]|2[0-3])([0-5][0-9]){2}Z-r(?!0000)[0-9a-f]{4}$"
        },
        "curated_latest_dir": { "type": "string", "minLength": 1 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "result",
          "verification_type",
          "exit_code",
          "contract_ref",
          "log_ref"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "waived"],
            "description": "Step 7: 'waived' indicates the stage was explicitly waived by REQ meta and excluded from judgement. An ALLOW gate is allowed to contain waived stages alongside passed ones, but every non-waived stage must be passed."
          },
          "verification_type": {
            "type": "string",
            "enum": [
              "command",
              "file_exists",
              "substring_match",
              "json_schema",
              "manual_check"
            ]
          },
          "exit_code": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "log_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "description": "ALLOW: failed_stage must be empty, decision.result must be ALLOW, every non-waived stage must have result=passed, and at least one passed stage must exist (Step 7: ALLOW with all stages waived is forbidden).",
      "if": {
        "properties": { "status": { "const": "ALLOW" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": { "result": { "const": "ALLOW" } }
          },
          "failed_stage": { "const": "" },
          "stages": {
            "items": {
              "properties": {
                "result": { "enum": ["passed", "waived"] }
              }
            },
            "contains": {
              "properties": { "result": { "const": "passed" } },
              "required": ["result"]
            }
          }
        }
      }
    },
    {
      "description": "DENY: decision.result must be DENY. Either a stage actually failed (failed_stage non-empty, at least one stage.result=failed) OR every adopted stage is waived (failed_stage empty, no stages.result=failed) — the latter is Step 7's 'no judgement material' branch.",
      "if": {
        "properties": { "status": { "const": "DENY" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": { "result": { "const": "DENY" } }
          }
        },
        "oneOf": [
          {
            "description": "Normal DENY: a stage failed.",
            "properties": {
              "failed_stage": { "minLength": 1 },
              "stages": {
                "contains": {
                  "properties": { "result": { "const": "failed" } },
                  "required": ["result"]
                }
              }
            }
          },
          {
            "description": "All-waived DENY (Step 7): no judgement material. failed_stage is empty and no stage has result=failed.",
            "properties": {
              "failed_stage": { "const": "" },
              "stages": {
                "items": {
                  "properties": { "result": { "const": "waived" } }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
