{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yumeno/Quality-gate-builder/schemas/gate.schema.json",
  "title": "qgb gate report (curated, strict)",
  "description": "Schema for the curated gate.json under evidence/<REQ>/latest/. Strict (additionalProperties false) to keep committed evidence clean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "req_id",
    "timestamp_utc",
    "timestamp_rfc3339",
    "phase",
    "status",
    "failed_stage",
    "decision",
    "runner",
    "paths",
    "stages",
    "basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z$"
    },
    "timestamp_rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "enum": ["red", "green", "refactor", "verify"]
    },
    "status": {
      "type": "string",
      "enum": ["ALLOW", "DENY"]
    },
    "failed_stage": {
      "type": "string",
      "description": "Empty string when status=ALLOW; first failed stage id when status=DENY."
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "meaning"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["ALLOW", "DENY"]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_dir", "curated_latest_dir"],
      "properties": {
        "run_dir": { "type": "string", "minLength": 1 },
        "curated_latest_dir": { "type": "string", "minLength": 1 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "result", "verification_type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "result": {
            "type": "string",
            "enum": ["passed", "failed"]
          },
          "verification_type": {
            "type": "string",
            "enum": [
              "command",
              "file_exists",
              "substring_match",
              "json_schema",
              "manual_check"
            ]
          },
          "exit_code": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "log_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "description": "decision.result must match status.",
      "if": {
        "properties": { "status": { "const": "ALLOW" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": { "result": { "const": "ALLOW" } }
          },
          "failed_stage": { "const": "" }
        }
      }
    },
    {
      "description": "DENY: failed_stage must be non-empty; decision.result must be DENY.",
      "if": {
        "properties": { "status": { "const": "DENY" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": { "result": { "const": "DENY" } }
          },
          "failed_stage": { "minLength": 1 }
        }
      }
    }
  ]
}
