{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "markdown-docs metadata",
  "description": "Schema for docs/metadata.json. Step 8: $ref is intentionally not used so qgb's Phase 1 json_schema runner accepts it.",
  "type": "object",
  "required": ["doc_set", "version", "language", "pages"],
  "additionalProperties": false,
  "properties": {
    "doc_set": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language": {
      "type": "string",
      "enum": ["en", "ja"]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "title"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/.+\\.md$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
